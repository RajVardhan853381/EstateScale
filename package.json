{
  "name": "estatescale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit tests/reliability tests/security tests/journeys tests/analytics",
    "test:db:up": "docker compose -p estatescale-test -f docker-compose.test.yml up -d --wait",
    "test:db:migrate": "npx --yes dotenv-cli -e .env.test -- prisma migrate deploy",
    "test:db:down": "docker compose -p estatescale-test -f docker-compose.test.yml down -v",
    "test:integration": "npx --yes dotenv-cli -e .env.test -- vitest run -c vitest.config.integration.ts --pool=threads --poolOptions.threads.singleThread=true",
    "test:ci": "npm run test:unit",
    "test": "vitest run --pool=threads --poolOptions.threads.singleThread=true",
    "test:watch": "vitest",
    "test:ci:e2e": "npx --yes dotenv-cli -e .env.test -- playwright test",
    "test:e2e": "npx --yes dotenv-cli -e .env.test -- playwright test",
    "postinstall": "prisma generate",
    "start:worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.60",
    "@auth/prisma-adapter": "^2.7.4",
    "@base-ui/react": "^1.7.0",
    "@prisma/client": "^5.10.0",
    "ai": "^7.0.87",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.38.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "twilio": "^6.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4.0.9",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.19",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.21.0",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.6",
    "prisma": "^5.10.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.0.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
