# Dedicated Test Environment Configuration (Isolated from Production / Staging)
# Used by: npm run test:integration, npm run test:e2e, docker-compose.test.yml

# Test PostgreSQL Database (mapped to port 5434 by docker-compose.test.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/estatescale_test"
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/estatescale_test"

# Test Redis Instance (mapped to port 6380 by docker-compose.test.yml)
REDIS_URL="redis://localhost:6380"

# Application Secrets for Testing
NODE_ENV="test"
AUTH_SECRET="test-auth-secret-key-at-least-16-chars-long"
NEXTAUTH_SECRET="test-auth-secret-key-at-least-16-chars-long"
NEXTAUTH_URL="http://localhost:3000"
CRON_SECRET="estatescale-test-cron-secret-1234"

# External Integrations (Mock / Test Credentials)
GEMINI_API_KEY="test-gemini-api-key"
TWILIO_ACCOUNT_SID="AC_mock_test_sid"
TWILIO_AUTH_TOKEN="mock_test_token"
TWILIO_PHONE_NUMBER="+15005550006"
