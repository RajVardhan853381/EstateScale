generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships OrganizationMembership[]
  accounts    Account[]
  sessions    Session[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED, DELETED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   OrganizationMembership[]
  Contact       Contact[]
  Lead          Lead[]
  Pipeline      Pipeline[]
  PipelineStage PipelineStage[]
  LeadActivity  LeadActivity[]
  Note          Note[]
  Tag           Tag[]
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String // OWNER, ADMIN, AGENT, STAFF
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Lead         Lead[]
  LeadActivity LeadActivity[]
  Note         Note[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

// NextAuth Required Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- PHASE 2: CRM & LEAD MANAGEMENT ---

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String?
  lastName       String?
  email          String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@index([organizationId, email])
  @@index([organizationId, phone])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  FOLLOW_UP
  APPOINTMENT_BOOKED
  CLOSED_WON
  CLOSED_LOST
}

model Lead {
  id              String  @id @default(cuid())
  organizationId  String
  contactId       String?
  assignedUserId  String?
  pipelineId      String?
  pipelineStageId String?

  source       String?
  status       LeadStatus @default(NEW)
  score        Int?
  intent       String?
  budget       Float?
  location     String?
  propertyType String?
  timeline     String?
  notes        String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact       Contact?                @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedUser  OrganizationMembership? @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  pipeline      Pipeline?               @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  pipelineStage PipelineStage?          @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)

  activities LeadActivity[]
  notesRel   Note[]
  tags       LeadTag[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, assignedUserId])
  @@index([organizationId, source])
  @@index([organizationId, pipelineStageId])
}

model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  leads        Lead[]

  @@index([organizationId])
}

model PipelineStage {
  id             String   @id @default(cuid())
  organizationId String
  pipelineId     String
  name           String
  order          Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@index([organizationId, pipelineId, order])
}

enum LeadActivityType {
  CREATED
  UPDATED
  ASSIGNED
  STATUS_CHANGED
  NOTE_ADDED
  TAG_ADDED
  TAG_REMOVED
  CONTACTED
  FOLLOW_UP
  APPOINTMENT
  SYSTEM
}

model LeadActivity {
  id             String           @id @default(cuid())
  organizationId String
  leadId         String
  userId         String?
  type           LeadActivityType
  description    String
  metadata       Json?
  createdAt      DateTime         @default(now())

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         OrganizationMembership? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, leadId, createdAt])
}

model Note {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  userId         String?
  content        String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         OrganizationMembership? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, leadId, createdAt])
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        LeadTag[]

  @@unique([organizationId, name])
}

model LeadTag {
  leadId String
  tagId  String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}
