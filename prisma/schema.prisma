generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships OrganizationMembership[]
  accounts    Account[]
  sessions    Session[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED, DELETED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships          OrganizationMembership[]
  contacts             Contact[]
  leads                Lead[]
  pipelines            Pipeline[]
  pipelineStages       PipelineStage[]
  leadActivities       LeadActivity[]
  notes                Note[]
  tags                 Tag[]
  aiUsages             AiUsage[]
  aiAssessments        AiAssessment[]
  automations          Automation[]
  automationExecutions AutomationExecution[]
  conversations        Conversation[]
  messages             Message[]
  communicationConfigs OrganizationCommunicationConfig[]
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String // OWNER, ADMIN, AGENT, STAFF
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  Lead         Lead[]
  LeadActivity LeadActivity[]
  Note         Note[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

// NextAuth Required Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  FOLLOW_UP
  APPOINTMENT_BOOKED
  CLOSED_WON
  CLOSED_LOST
}

enum LeadActivityType {
  CREATED
  UPDATED
  ASSIGNED
  STATUS_CHANGED
  NOTE_ADDED
  TAG_ADDED
  TAG_REMOVED
  CONTACTED
  FOLLOW_UP
  APPOINTMENT
  SYSTEM
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String
  firstName      String?
  lastName       String?
  email          String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        Lead[]

  conversations Conversation[]

  @@index([organizationId, email])
  @@index([organizationId, phone])
}

model Lead {
  id              String  @id @default(cuid())
  organizationId  String
  contactId       String?
  assignedUserId  String?
  pipelineId      String?
  pipelineStageId String?

  source       String?
  status       LeadStatus @default(NEW)
  score        Int?
  intent       String?
  budget       Float?
  location     String?
  propertyType String?
  timeline     String?

  notesText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact       Contact?                @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedUser  OrganizationMembership? @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  pipeline      Pipeline?               @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  pipelineStage PipelineStage?          @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)

  activities           LeadActivity[]
  notes                Note[]
  tags                 LeadTag[]
  aiAssessments        AiAssessment[]
  automationExecutions AutomationExecution[]

  conversations Conversation[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, assignedUserId])
  @@index([organizationId, source])
  @@index([organizationId, pipelineStageId])
}

model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages       PipelineStage[]
  leads        Lead[]

  @@index([organizationId])
}

model PipelineStage {
  id             String   @id @default(cuid())
  organizationId String
  pipelineId     String
  name           String
  order          Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline     Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@index([organizationId, pipelineId, order])
}

model LeadActivity {
  id             String           @id @default(cuid())
  organizationId String
  leadId         String
  userId         String?
  type           LeadActivityType
  description    String
  metadata       Json?
  createdAt      DateTime         @default(now())

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         OrganizationMembership? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, leadId, createdAt])
}

model Note {
  id             String   @id @default(cuid())
  organizationId String
  leadId         String
  userId         String?
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user         OrganizationMembership? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, leadId, createdAt])
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads        LeadTag[]

  @@unique([organizationId, name])
  @@index([organizationId, name])
}

model LeadTag {
  leadId String
  tagId  String

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([leadId])
  @@index([tagId])
}

model AiUsage {
  id             String   @id @default(cuid())
  organizationId String
  provider       String
  model          String
  operation      String
  inputTokens    Int?
  outputTokens   Int?
  estimatedCost  Float?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model AiAssessment {
  id                  String   @id @default(cuid())
  organizationId      String
  leadId              String
  intent              String?
  qualificationStatus String?
  qualificationReason String?
  score               Int?
  scoreReasoning      String?
  suggestedResponse   String?
  model               String
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId, createdAt])
}

enum AutomationTriggerType {
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  TAG_ADDED
  MANUAL
  SCHEDULED
  MESSAGE_RECEIVED
}

enum AutomationActionType {
  SEND_SMS
  SEND_EMAIL
  UPDATE_LEAD_STATUS
  ADD_TAG
  ASSIGN_USER
  AI_LEAD_ANALYSIS
  AI_LEAD_RESPONSE_GENERATION
}

model Automation {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  enabled        Boolean  @default(true)
  triggerType    String // LEAD_CREATED, LEAD_UPDATED, AI_ANALYSIS_COMPLETED
  actionType     String // AI_LEAD_ANALYSIS, AI_LEAD_RESPONSE_GENERATION
  configuration  Json? // Optional specific triggers parameters
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automationExecutions AutomationExecution[]

  @@index([organizationId, triggerType, enabled])
}

model AutomationExecution {
  id             String    @id @default(cuid())
  organizationId String
  automationId   String
  leadId         String
  status         String // PENDING, PROCESSING, COMPLETED, FAILED
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?   @db.Text
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automation   Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, leadId, automationId])
}

// --- PHASE 5: COMMUNICATION ENGINE ---

model Conversation {
  id             String             @id @default(cuid())
  organizationId String
  leadId         String?
  contactId      String
  channel        String             @default("SMS")
  status         ConversationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([organizationId, leadId])
  @@index([organizationId, contactId])
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  OPT_OUT
}

model Message {
  id             String           @id @default(cuid())
  organizationId String
  conversationId String
  direction      MessageDirection
  status         MessageStatus    @default(QUEUED)
  body           String
  from           String
  to             String
  externalId     String?
  provider       String           @default("TWILIO")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  metadata       Json?
  error          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId, conversationId, createdAt])
  @@index([organizationId, externalId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  RECEIVED
}

model OrganizationCommunicationConfig {
  id             String   @id @default(cuid())
  organizationId String
  provider       String   @default("TWILIO")
  phoneNumber    String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phoneNumber])
  @@index([phoneNumber])
}
