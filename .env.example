# ==========================================
# EstateScale Production Environment Configuration
# ==========================================

# 1. Database (Neon Serverless PostgreSQL)
# - DATABASE_URL: Use Neon pooled connection URL (port 6543 or -pooler hostname with ?sslmode=require&pgbouncer=true&connection_limit=10)
# - DIRECT_URL: Direct non-pooled connection URL (for running Prisma migrations)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Authentication (NextAuth v5 / Auth.js)
# Generate a strong 32+ character random secret using: openssl rand -base64 32
AUTH_SECRET="generate-a-strong-random-32-byte-secret-for-production"
AUTH_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# 3. Optional Google OAuth Provider
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 4. Google Gemini Two-Tier Integration (Tier 1: Gemini 3.8 Flash, Tier 2: Gemini 1.5 Flash 8B)
# If left empty, EstateScale automatically uses deterministic MockAIProvider for tests
GEMINI_API_KEY=""
GEMINI_REASONING_MODEL="gemini-3.8-flash"
GEMINI_ECONOMY_MODEL="gemini-1.5-flash-8b"
AI_FALLBACK_ENABLED="true"

# 5. Twilio Carrier Communication (SMS Auto-Responder & 2-Way Messaging)
# If left empty, EstateScale automatically uses deterministic MockCommunicationProvider
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+15550000000"

# 6. Cron Security (For scheduled visual journeys and outbox recovery)
CRON_SECRET="generate-a-random-secret-for-cron-endpoints"

# 7. Optional Redis URL (Only required if scaling beyond ~50 users to external BullMQ clusters)
# Leave empty for Zero-Redis in-process execution mode (< 50 concurrent users)
REDIS_URL=""
