# PostgreSQL Database (Required)
DATABASE_URL="postgresql://postgres:password@localhost:5432/estatescale?schema=public"

# Redis Queue Database (Required)
REDIS_URL="redis://localhost:6379"

# NextAuth Configuration (Required)
AUTH_SECRET="development-secret-key-do-not-use-in-production-12345678"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (Optional - defaults to mock mode if absent)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Twilio Configuration (Required for SMS features)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WEBHOOK_URL="http://localhost:3000/api/webhooks/twilio"

# OpenAI Configuration (Required for AI features)
OPENAI_API_KEY=""

# Observability
LOG_LEVEL="info"
